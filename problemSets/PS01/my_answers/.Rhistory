kolmogorov_smirnov_test <- function(data) {
data <- sort(data)
n <- length(data)
F_theo <- pnorm(data)
D_plus  <- (1:n)/n - F_theo
D_minus <- F_theo - (0:(n-1))/n
D <- max(c(D_plus, D_minus))
return(D)
}
kolmogorov_smirnov_test(100)
ks(100)
ks.test(100)
ks.test(100, 50)
